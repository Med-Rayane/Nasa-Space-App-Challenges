# Optional: override the Opportunity (Spirit & Opportunity) model.
# The other artifacts are wired directly in src/components/Canvas3D.jsx:
#   solar-system.glb, ingenuity.glb, insight.glb, surveyor3.glb
# VITE_MODEL_URL=/models/opportunity.glb

# Any .glb also works here, e.g. to preview another artifact in chapter 01:
# VITE_MODEL_URL=/models/ingenuity.glb
# VITE_MODEL_URL=/models/insight.glb
# VITE_MODEL_URL=/models/solar-system.glb
